# Copia a .env y llena tus datos (el .env real nunca se sube a git).
OPENROUTER_API_KEY=sk-or-v1-TU-CLAVE
# Los modelos :free cambian; si aparece 404, elige otro en
# https://openrouter.ai/models?max_price=0 (acepta lista separada por comas).
IA_MODEL=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
IA_PORT=8001
# 1 = pre-formaliza facultades/límites antes del machote (preview técnico, +1 llamada IA).
# 0 = solo prompt duro (más rápido, menos garantía en modelos free).
IA_PRE_FORMALIZAR=1
