# Copia como "server/.env.test" (ignorado). SOLO para la BD de pruebas.
# npm test usa esta configuración y se niega a correr si DB_NAME no termina en _test.
DB_HOST=localhost
DB_PORT=3306
DB_USER=sislegal
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_NAME=sislegal_test
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO
JWT_HORAS=8
API_PORT=8000

# Solo lo usa `npm run db:test:prep` para recrear sislegal_test desde db/maestro.sql.
# Es una cuenta con permiso para CREATE/DROP DATABASE; no la uses para la app.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_ROOT
# Host al que se le concede acceso a la BD de pruebas (normalmente localhost).
DB_GRANT_HOST=localhost
