# Copia como ".env" junto al docker-compose.yml (nunca se sube a git).
# Solo Docker: tu server/.env y ai-service/.env locales NO se usan dentro del compose.

# --- MariaDB ---
DB_USER=sislegal
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_ROOT_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_PORT=3306

# --- API ---
JWT_SECRET=PEGA-AQUI-UN-SECRETO-LARGO-Y-ALEATORIO

# --- IA (OpenRouter) ---
OPENROUTER_API_KEY=PEGA-AQUI-TU-CLAVE-DE-OPENROUTER
# Los modelos :free cambian: si la IA responde 404, elige otro en
# https://openrouter.ai/models?max_price=0 (acepta lista separada por comas).
IA_MODEL=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
IA_PROVIDER=openrouter
# GOOGLE_API_KEY=PEGA-AQUI-TU-CLAVE-DE-GOOGLE-SOLO-SI-USAS-GEMINI
IA_PRE_FORMALIZAR=1

# --- Web (lo que el navegador usa para llamar a la API) ---
VITE_API_URL=http://localhost:8000/api
